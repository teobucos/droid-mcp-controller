{
  "name": "droid-mcp-controller",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "for f in src/*.mjs scripts/*.mjs; do node --check $f || exit 1; done && node scripts/gen-tool-reference.mjs --check",
    "docs": "node scripts/gen-tool-reference.mjs"
  },
  "dependencies": {
    "@factory/droid-sdk": "0.9.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "3.25.76"
  },
  "overrides": {
    "@factory/droid-sdk": {
      "uuid": "11.1.1"
    }
  }
}
